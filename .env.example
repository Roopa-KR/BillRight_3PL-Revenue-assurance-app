# Copy to .env. No secret is stored in code.
APP_ENV=production                # 'development' enables the local e-mail login (never in production)
SECRET_KEY=change-me-to-a-long-random-value
# Application role WITHOUT superuser / BYPASSRLS, so PostgreSQL row-level security applies
DATABASE_URL=postgresql+psycopg://billright_app:CHANGE_ME@db/billright
# Owner role: migrations only
DATABASE_OWNER_URL=postgresql+psycopg://billright:CHANGE_ME@db/billright
# OIDC single sign-on (Entra ID, Okta, Google, Keycloak, ...)
OIDC_ISSUER=https://login.example.com/tenant/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://billright.example.com/login/callback
SESSION_COOKIE_SECURE=1
UPLOAD_DIR=/data/uploads          # photos from work capture, stored outside the database
